# Copy to .env and fill in. .env is gitignored — never commit it.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional — Claude model used by every agent (default: claude-sonnet-5)
# QA_AGENT_MODEL=claude-sonnet-5

# Optional — set to false to run Playwright headless (default: visible browser)
# HEADED=true
